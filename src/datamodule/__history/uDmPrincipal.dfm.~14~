  object qryEstTecidos: TFDQuery
    Connection = dmConexao.Conexao
    SQL.Strings = (
      'SELECT'
      #9#9'nfe.nfe_id,'
      #9#9'nfe.nfe_codnfe,'
      #9#9'nfe.nfe_dtrecebimento,'
      #9#9'cp.cp_id,'
      #9#9'cp.cp_descricao,'
      #9#9'(gc.grc_codexterno || '#39' - '#39' || gc.grc_nome) AS grc_nome,'
      #9#9'gt.grt_nome,'
      #9#9'('
      #9#9#9#9'SELECT pnfe_pcofornecedor'
      #9#9#9#9#9'FROM produto_nf_entrada WHERE pnfe_idnfe=nfe.nfe_id'
      #9#9#9#9#9'AND pnfe_codprod=cp.cp_id'
      #9#9#9#9#9'ORDER BY pnfe_id DESC'
      #9#9#9#9#9'LIMIT 1'
      #9#9') AS pnfe_pcofornecedor,'
      #9#9'cc.comp_id,'
      #9#9'cc.comp_nome,'
      #9#9'igf.ig_numrolo,'
      #9#9'igf.ig_qtdadeforn,'
      #9#9'(igf.ig_quantidade) AS entrada,'
      #9#9'cp.cp_unestoque,'
      #9#9'('
      #9#9#9#9'SELECT pnfe_uncom'
      #9#9#9#9'FROM produto_nf_entrada WHERE pnfe_idnfe=nfe.nfe_id'
      #9#9#9#9'AND pnfe_codprod=cp.cp_id'
      #9#9#9#9'ORDER BY pnfe_id DESC'
      #9#9#9#9'LIMIT 1'
      #9#9') AS pnfe_uncom,'
      
        #9#9'(CASE WHEN coalesce(e.es_saidabalanco, 0.0000)>0 OR coalesce(e' +
        '.es_entbalanco, 0.0000)>0 THEN '#39'SIM'#39' ELSE '#39'N'#195'O'#39' END) AS balanco,'
      #9#9'('
      #9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_entradaforn, 0.0000) - coalesce(e.es_saidafo' +
        'rn, 0.000) +'
      
        #9#9#9#9#9#9'coalesce(e.es_enttransf, 0.000) - coalesce(e.es_saidatrans' +
        'f, 0.0000)'
      #9#9#9#9') -'
      #9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_saidabalanco, 0.0000) - coalesce(e.es_entbal' +
        'anco, 0.0000)'
      #9#9#9#9') '
      #9#9') AS estoque_fisico,'
      #9#9'('
      
        #9#9#9#9'coalesce(e.es_saidaempenho, 0.0000) - coalesce(e.es_entempen' +
        'ho, 0.0000)'
      #9#9') AS empenhos,'
      #9#9'('
      #9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_entradaforn, 0.0000) - coalesce(e.es_saidafo' +
        'rn, 0.000) +'
      
        #9#9#9#9#9#9'coalesce(e.es_enttransf, 0.000) - coalesce(e.es_saidatrans' +
        'f, 0.0000)'
      #9#9#9#9') -'
      #9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_saidaempenho, 0.0000) - coalesce(e.es_entemp' +
        'enho, 0.0000)'
      #9#9#9#9') -'
      #9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_saidabalanco, 0.0000) - coalesce(e.es_entbal' +
        'anco, 0.0000)'
      #9#9#9#9')'
      #9#9') AS disponivel_para_empenho,'
      #9#9'coalesce(e.es_custoatual, 0) AS es_custoatual,'
      #9#9'f.for_nome,'
      #9#9'f.for_apelido,'
      #9#9'e.es_id,'
      #9#9'igf.ig_fatorconversao'
      #9#9'FROM estoque AS e'
      #9#9'JOIN cadastro_produto AS cp ON e.es_codproduto = cp.cp_id'
      #9#9'JOIN grade_cor AS gc ON gc.grc_id = e.es_idgradecor'
      #9#9'JOIN grade_tamanho AS gt ON gt.grt_id = e.es_idgradetam'
      
        #9#9'LEFT JOIN itens_grade_nfentrada AS igf ON igf.ig_codproduto=cp' +
        '.cp_id AND e.es_codproduto=igf.ig_codproduto'
      
        #9#9'AND igf.ig_gradecor=gc.grc_id AND e.es_idgradecor=igf.ig_grade' +
        'cor'
      
        #9#9'AND igf.ig_gradetam=gt.grt_id AND e.es_idgradetam=igf.ig_grade' +
        'tam'
      #9#9'AND igf.ig_numrolo=e.es_numrolo'
      #9#9'AND igf.ig_metragemrolo=e.es_metragemrolo'
      
        #9#9'LEFT JOIN nota_fiscal_entrada AS nfe ON igf.ig_idnfent=nfe.nfe' +
        '_id'
      
        #9#9'LEFT JOIN cadastro_compradores AS cc ON cc.comp_id = igf.ig_id' +
        'comprador'
      #9#9'LEFT JOIN fornecedor AS f ON f.for_codigo = nfe.nfe_codforn'
      #9#9'LEFT JOIN itens_xml AS ixml ON ixml.pnfe_idnfe=nfe.nfe_id'
      #9#9'AND ixml.pnfe_coditem=igf.ig_codproduto'
      #9#9'WHERE 1=1'
      #9#9'AND'
      #9#9#9#9'('
      #9#9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_entradaforn, 0.0000) - coalesce(e.es_saidafo' +
        'rn, 0.000) +'
      
        #9#9#9#9#9#9'coalesce(e.es_enttransf, 0.000) - coalesce(e.es_saidatrans' +
        'f, 0.0000)'
      #9#9#9#9#9') -'
      #9#9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_saidaempenho, 0.0000) - coalesce(e.es_entemp' +
        'enho, 0.0000)'
      #9#9#9#9#9') -'
      #9#9#9#9#9'('
      
        #9#9#9#9#9#9'coalesce(e.es_saidabalanco, 0.0000) - coalesce(e.es_entbal' +
        'anco, 0.0000)'
      #9#9#9#9#9')'
      #9#9#9#9') >=0'
      #9#9'AND cp.cp_id=4653'#9
      #9#9'GROUP BY'
      #9#9#9#9'nfe.nfe_id,'
      #9#9#9#9'nfe.nfe_codnfe,'
      #9#9#9#9'nfe.nfe_dtrecebimento,'
      #9#9#9#9'cp.cp_id,'
      #9#9#9#9'cp.cp_descricao,'
      #9#9#9#9'gc.grc_codexterno,'
      #9#9#9#9'gc.grc_nome,'
      #9#9#9#9'gt.grt_nome,'
      #9#9#9#9'cc.comp_id,'
      #9#9#9#9'cc.comp_nome,'
      #9#9#9#9'igf.ig_numrolo,'
      #9#9#9#9'igf.ig_metragemrolo,'
      #9#9#9#9'igf.ig_qtdadeforn,'
      #9#9#9#9'cp.cp_unestoque,'
      #9#9#9#9'e.es_id,'
      #9#9#9#9'e.es_entradaforn,'
      #9#9#9#9'e.es_saidaforn,'
      #9#9#9#9'e.es_enttransf,'
      #9#9#9#9'e.es_saidatransf,'
      #9#9#9#9'e.es_saidaempenho,'
      #9#9#9#9'e.es_entempenho,'
      #9#9#9#9'e.es_entbalanco,'
      #9#9#9#9'e.es_saidabalanco,'
      #9#9#9#9'e.es_custoatual,'
      #9#9#9#9'e.es_metragemrolo,'
      #9#9#9#9'f.for_nome,'
      #9#9#9#9'f.for_apelido,'
      #9#9#9#9'igf.ig_quantidade,'
      #9#9#9#9'igf.ig_fatorconversao'
      #9#9'ORDER BY'
      #9#9#9#9'cc.comp_nome,'
      #9#9#9#9'nfe.nfe_id,'
      
        '(SUBSTRING (gc.grc_codexterno, 1, 1), lpad(SUBSTRING (gc.grc_cod' +
        'externo, 2), 5, '#39'0'#39'))')
    Left = 72
    Top = 336
