    ShowMessage('Estou no botao RETIRAR');
end;



procedure TfrmFiltroProdutividade.dbLkFaseExit(Sender: TObject);
begin
    with dmFiltroProdutividade.qryUsuarioFase do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     u.us_id,');
        SQL.Add('     u.us_nome');
        SQL.Add('     FROM fase_producao fp');
        SQL.Add('     JOIN cadastro_setor cs ON fp.fa_id = cs.se_idfase');
        SQL.Add('     JOIN usuario u ON cs.se_id = u.us_idsetor');
        SQL.Add('     WHERE fp.fa_id = :idFase');

        ParamByName('idFase').AsInteger   :=dbLkFase.KeyValue;
        Open
    end;

    dmFiltroProdutividade.qryUsuarioFase.Active    :=true;
    dbLkUsuario.ListSource                         :=dmFiltroProdutividade.dsUsuarioFase;
    dbLkUsuario.ListField                          :='us_nome';
    dbLkUsuario.KeyField                           :='us_id';
end;

procedure TfrmFiltroProdutividade.dbLkGrupoExit(Sender: TObject);
begin
    with dmFiltroProdutividade.qrySubGrupo do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     sgr_id,');
        SQL.Add('     sgr_nome,');
        SQL.Add('     sgr_idgrupo');
        SQL.Add('     FROM subgrupo_prodacabado');
        SQL.Add('     WHERE sgr_idgrupo = :idGrupo');
        SQL.Add('     ORDER BY sgr_nome');

        ParamByName('idGrupo').AsInteger   :=dbLkGrupo.KeyValue;
        Open
    end;

    dmFiltroProdutividade.qrySubGrupo.Active       :=true;
    dbLkSubGrupo.ListSource                        :=dmFiltroProdutividade.dsSubGrupo;
    dbLkSubGrupo.ListField                         :='sgr_nome';
    dbLkSubGrupo.KeyField                          :='sgr_id';
end;

procedure TfrmFiltroProdutividade.dbLkSubGrupoExit(Sender: TObject);
begin
    with dmFiltroProdutividade.qryTipo do
