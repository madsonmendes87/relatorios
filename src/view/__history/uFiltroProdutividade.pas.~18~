end;


procedure TfrmFiltroProdutividade.FormCreate(Sender: TObject);
begin
    KeyPreview  :=true;

    FKeyMap := TDictionary<Word, TSpeedButton>.Create;
    FKeyMap.Add(VK_F1, btnGerar);
    FKeyMap.Add(VK_F2, btnBuscar);
    FKeyMap.Add(VK_F3, btnLimpar);
    FKeyMap.Add(VK_F4, btnRetirar);

end;

procedure TfrmFiltroProdutividade.FormKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);

  var
    btn : TSpeedButton;

begin
    if FKeyMap.TryGetValue(Key, btn) then
    begin
      btn.Click;
      Key :=0;
    end;
end;

procedure TfrmFiltroProdutividade.FormShow(Sender: TObject);
begin
    chkGE.Checked                                   :=true;
    chkOrdemProducao.Checked                        :=true;
    chkSintetico.Checked                            :=true;


    with dmFiltroProdutividade.qryFase do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     fa_id,');
        SQL.Add('     fa_nome');
        SQL.Add('     FROM fase_producao');
        SQL.Add('     ORDER BY fa_nome');
        Open;
    end;


    dmFiltroProdutividade.qryFase.Active           :=true;
    dbLkFase.ListSource                            :=dmFiltroProdutividade.dsFase;
    dbLkFase.ListField                             :='fa_nome';
    dbLkFase.KeyField                              :='fa_id';
    dbLkFase.KeyValue                              :=2;




    with dmFiltroProdutividade.qryUsuarioFase do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     u.us_id,');
        SQL.Add('     u.us_nome');
        SQL.Add('     FROM fase_producao fp');
        SQL.Add('     JOIN cadastro_setor cs ON fp.fa_id = cs.se_idfase');
        SQL.Add('     JOIN usuario u ON cs.se_id = u.us_idsetor');
        SQL.Add('     WHERE fp.fa_id = :idFase');

        ParamByName('idFase').AsInteger   :=dbLkFase.KeyValue;
        Open;
    end;

    dmFiltroProdutividade.qryUsuarioFase.Active    :=true;
    dbLkUsuario.ListSource                         :=dmFiltroProdutividade.dsUsuarioFase;
    dbLkUsuario.ListField                          :='us_nome';
    dbLkUsuario.KeyField                           :='us_id';


    with dmFiltroProdutividade.qryEstilista do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     es_id,');
        SQL.Add('     es_nome');
        SQL.Add('     FROM cadastro_estilista e');
        SQL.Add('     ORDER BY es_nome');
        Open;
    end;

    dmFiltroProdutividade.qryEstilista.Active      :=true;
    dbLkEstilista.ListSource                       :=dmFiltroProdutividade.dsEstilista;
    dbLkEstilista.ListField                        :='es_nome';
    dbLkEstilista.KeyField                         :='es_id';



    with dmFiltroProdutividade.qryGrupo do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     gr_id,');
        SQL.Add('     gr_nome');
        SQL.Add('     FROM grupo_prodacabado');
        SQL.Add('     ORDER BY gr_nome');
        Open;
    end;

    dmFiltroProdutividade.qryGrupo.Active         :=true;
    dbLkGrupo.ListSource                       :=dmFiltroProdutividade.dsGrupo;
    dbLkGrupo.ListField                        :='gr_nome';
    dbLkGrupo.KeyField                         :='gr_id';
end;

