uses uFiltroArtigo, uDmPrincipal, uConexao;

{ TfrmRelArtigos }

procedure TfrmRelArtigos.carregarDados;
begin
    dmConexao.Conexao.Connected := true;

    with dmPrincipal.qryDadosArtigo do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     cp.cp_id,');
        SQL.Add('     cp.cp_descricao,');
        SQL.Add('     gr.gr_nome,');
        SQL.Add('     sgr.sgr_nome,');
        SQL.Add('     tp.tp_nome,');
        SQL.Add('     cm.cm_descricao');
        SQL.Add('     FROM cadastro_produto AS cp');
        SQL.Add('     LEFT JOIN grupo AS gr ON gr.gr_id = cp.cp_idgrupo');
        SQL.Add('     LEFT JOIN subgrupo AS sgr ON sgr.sgr_id = cp.cp_idsubgrupo');
        SQL.Add('     LEFT JOIN tipo_produto AS tp ON tp.tp_id = cp.cp_idtipoproduto');
        SQL.Add('     LEFT JOIN composicao_material AS cm ON cm.cm_id = cp.cp_idcomposicao');
        SQL.Add('     WHERE cp_id = :idArtigo');

        ParamByName('idArtigo').AsInteger   :=StrToInt(frmFiltroArtigo.edtCodigo.Text);
        Open;
    end;


    dmPrincipal.dsDadosArtigo.DataSet     :=dmPrincipal.qryDadosArtigo;

    rlDBCodigo.DataSource                 :=dmPrincipal.dsDadosArtigo;
    rlDBCodigo.DataField                  :='cp_id';

    rlDBProduto.DataSource                :=dmPrincipal.dsDadosArtigo;
    rlDBProduto.DataField                 :='cp_descricao';

    rlDBGrupo.DataSource                  :=dmPrincipal.dsDadosArtigo;
    rlDBGrupo.DataField                   :='gr_nome';

    rlDBSubgrupo.DataSource               :=dmPrincipal.dsDadosArtigo;
    rlDBSubGrupo.DataField                :='sgr_nome';

    rlDBTipoProduto.DataSource            :=dmPrincipal.dsDadosArtigo;
    rlDBTipoProduto.DataField             :='tp_nome';

    rlDBComposicao.DataSource             :=dmPrincipal.dsDadosArtigo;
    rlDBComposicao.DataField              :='cm_descricao';


    with dmPrincipal.qryEstArtigo do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     CAST(');
        SQL.Add('             COALESCE(gc.grc_codexterno, '''') || '' - '' || TRIM(gc.grc_nome) AS VARCHAR(50)');
        SQL.Add('         ) AS grc_nome_pa,');
        SQL.Add('     gt.grt_nome,');
        SQL.Add('     CASE');
        SQL.Add('         WHEN es.es_entbalanco > 0 THEN ''SIM''');
        SQL.Add('         ELSE ''NAO''');
        SQL.Add('     END AS balanco,');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                     ) -');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                     )');
        SQL.Add('               ) AS VARCHAR(20)');
        SQL.Add('         ) || '' '' || cp.cp_un AS estoque_fisico,');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                             COALESCE(es.es_entempenho, 0)');
        SQL.Add('                     )');
        SQL.Add('               ) AS VARCHAR(20)');
        SQL.Add('         ) || '' '' || cp.cp_un AS empenhos,');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                     ) -');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                     )');
        SQL.Add('                     -');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                             COALESCE(es.es_entempenho, 0)');
        SQL.Add('                     )');
        SQL.Add('               ) AS VARCHAR(20)');
        SQL.Add('         ) || '' '' || cp.cp_un AS estoque_disponivel,');
        SQL.Add('         es.es_custoatual,');
        SQL.Add('     SUM(');
        SQL.Add('              (');
        SQL.Add('                       COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                       COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                       COALESCE(es.es_entbalanco, 0)');
        SQL.Add('               ) -');
        SQL.Add('               (');
        SQL.Add('                       COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                       COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                       COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('               )');
        SQL.Add('        ) OVER() AS total_estoque_fisico,');
        SQL.Add('     SUM(');
        SQL.Add('               COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('               COALESCE(es.es_entempenho, 0)');
        SQL.Add('        ) OVER() AS total_empenhos,');
        SQL.Add('     SUM(');
        SQL.Add('              (');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                     ) -');
        SQL.Add('                     (');
        SQL.Add('                             COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                     )');
        SQL.Add('              ) -');
        SQL.Add('              (');
        SQL.Add('                     COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                     COALESCE(es.es_entempenho, 0)');
        SQL.Add('              )');
        SQL.Add('        ) OVER() AS total_estoque_disponivel');
        SQL.Add('     FROM estoque AS es');
        SQL.Add('     JOIN grade_cor AS gc ON gc.grc_id = es.es_idgradecor');
        SQL.Add('     JOIN grade_tamanho AS gt ON gt.grt_id = es.es_idgradetam');
        SQL.Add('     JOIN cadastro_produto AS cp ON cp.cp_id = es.es_codproduto');
        SQL.Add('     WHERE es_codproduto = :idArtigo');

        ParamByName('idArtigo').AsInteger   :=StrToInt(frmFiltroArtigo.edtCodigo.Text);
        Open;
    end;



    dmPrincipal.dsEstArtigo.DataSet     :=dmPrincipal.qryEstArtigo;

    rlRelArtigos.DataSource             :=dmPrincipal.dsEstArtigo;

    rlDBCor.DataSource                  :=dmPrincipal.dsEstArtigo;
    rlDBCor.DataField                   :='grc_nome_pa';

    rlDBTamanho.DataSource              :=dmPrincipal.dsEstArtigo;
    rlDBTamanho.DataField               :='grt_nome';

    rlDBBalanco.DataSource              :=dmPrincipal.dsEstArtigo;
    rlDBBalanco.DataField               :='balanco';

    rlDBFisico.DataSource               :=dmPrincipal.dsEstArtigo;
    rlDBFisico.DataField                :='estoque_fisico';

    rlDBEmpenhos.DataSource             :=dmPrincipal.dsEstArtigo;
    rlDBEmpenhos.DataField              :='empenhos';

    rlDBDisponivel.DataSource           :=dmPrincipal.dsEstArtigo;
    rlDBDisponivel.DataField            :='estoque_disponivel';

    rlDBCusto.DataSource                :=dmPrincipal.dsEstArtigo;
    rlDBCusto.DataField                 :='es_custoatual';



    with dmPrincipal.qryTotaisEstoque do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('       SUM(');
        SQL.Add('                 (');
        SQL.Add('                         COALESCE(es.es_entradaforn,0) +');
        SQL.Add('                         COALESCE(es.es_enttransf,0) +');
        SQL.Add('                         COALESCE(es.es_entbalanco,0)');
        SQL.Add('                 ) -');
        SQL.Add('                 (');
        SQL.Add('                         COALESCE(es.es_saidaforn,0) +');
        SQL.Add('                         COALESCE(es.es_saidatransf,0) +');
        SQL.Add('                         COALESCE(es.es_saidabalanco,0)');
        SQL.Add('                 )');
        SQL.Add('         ) AS total_estoque_fisico,');
        SQL.Add('       SUM(');
        SQL.Add('                 COALESCE(es.es_saidaempenho,0) -');
        SQL.Add('                 COALESCE(es.es_entempenho,0)');
        SQL.Add('       ) AS total_empenhos,');
        SQL.Add('       SUM(');
        SQL.Add('                 (');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_entradaforn,0) +');
        SQL.Add('                             COALESCE(es.es_enttransf,0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco,0)');
        SQL.Add('                       ) -');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_saidaforn,0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf,0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco,0)');
        SQL.Add('                       )');
        SQL.Add('                ) -');
        SQL.Add('                (');
        SQL.Add('                         COALESCE(es.es_saidaempenho,0) -');
        SQL.Add('                         COALESCE(es.es_entempenho,0)');
        SQL.Add('                )');
        SQL.Add('        ) AS total_estoque_disponivel');
        SQL.Add('        FROM estoque es');
        SQL.Add('       WHERE es.es_codproduto = :idArtigo');

        ParamByName('idArtigo').AsInteger   :=StrToInt(frmFiltroArtigo.edtCodigo.Text);
        Open;
    end;


    dmPrincipal.dsTotaisEstoque.DataSet     :=dmPrincipal.qryTotaisEstoque;


    rlDBTotFisico.DataSource                :=dmPrincipal.dsTotaisEstoque;
    rlDBTotFisico.DataField                 :='total_estoque_fisico';

    rlDBTotEmpenhos.DataSource := dmPrincipal.dsTotaisEstoque;
    rlDBTotEmpenhos.DataField  := 'total_empenhos';

    rlDBTotDisponivel.DataSource := dmPrincipal.dsTotaisEstoque;
    rlDBTotDisponivel.DataField  := 'total_estoque_disponivel';
end;



