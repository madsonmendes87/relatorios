unit uRelArtigos;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, RLReport, Vcl.Imaging.pngimage;

type
  TfrmRelArtigos = class(TForm)
    rlRelArtigos: TRLReport;
    rlCabecalho: TRLBand;
    rLabelCod: TRLLabel;
    rLabProduto: TRLLabel;
    rLabTipoProd: TRLLabel;
    rlComposicao: TRLLabel;
    rlDBCodigo: TRLDBText;
    rlDBComposicao: TRLDBText;
    rlDBGrupo: TRLDBText;
    rlDBProduto: TRLDBText;
    rlDBSubgrupo: TRLDBText;
    rlDBTipoProduto: TRLDBText;
    rlGrupo: TRLLabel;
    rlImageJFI: TRLImage;
    rlImageNAT: TRLImage;
    rlSubGrupo: TRLLabel;
    RLDraw9: TRLDraw;
    RLLabel12: TRLLabel;
    rlLabCor: TRLLabel;
    rlLabTamanho: TRLLabel;
    rlLblCusto: TRLLabel;
    rlDadosEstoque: TRLBand;
    rlPanelCor: TRLPanel;
    rlDBCor: TRLDBMemo;
    rlPanelTamanho: TRLPanel;
    rlDBTamanho: TRLDBText;
    rlPanTitCor: TRLPanel;
    rlPanelTitTam: TRLPanel;
    rlPanBalanco: TRLPanel;
    rlDBTitBalanco: TRLLabel;
    rlPanBalanco_: TRLPanel;
    rlDBBalanco: TRLDBText;
    rlPanEstFisico: TRLPanel;
    rlLabEstFisico: TRLLabel;
    rlPanEstFisico_: TRLPanel;
    rlDBEstFisico: TRLDBText;
    rlPanelTitEmpenhos: TRLPanel;
    rlLbEmpTItulo: TRLLabel;
    rlPanEmp_: TRLPanel;
    rlDBEmpenho: TRLDBText;
    rlPanEstDisp: TRLPanel;
    rlLabEstDisp: TRLLabel;
    rlPanelEstoqueDisp: TRLPanel;
    rlDBEstDisponivel: TRLDBText;
    rlPanelCusto: TRLPanel;
    rlPanCusto_: TRLPanel;
    rlDBCusto: TRLDBText;
    rlTotais: TRLBand;
    rlPanTotFisico: TRLPanel;
    rlLblTotFisico: TRLLabel;
    rlDBTotFisico: TRLLabel;
    rlTotalEmpenhos: TRLPanel;
    rlLblTotalEmpenhos: TRLLabel;
    rlDBTotEmpenhos: TRLLabel;
    rlPanelTotDisp: TRLPanel;
    RLLabel1: TRLLabel;
    rlDBTotDisponivel: TRLLabel;
    procedure rlTotaisBeforePrint(Sender: TObject; var PrintIt: Boolean);
  private
    { Private declarations }
  public
    { Public declarations }
    procedure carregarDados;
  end;

var
  frmRelArtigos: TfrmRelArtigos;

implementation

{$R *.dfm}

uses uFiltroArtigo, uConexao, uDmPrincipal;

{ TfrmRelArtigos }

procedure TfrmRelArtigos.carregarDados;
begin
    {CABEÇALHO RELATÓRIO}

    dmConexao.Conexao.Connected :=true;

    dmPrincipal.dsDadosArtigo.DataSet     :=dmPrincipal.qryDadosArtigo;

    rlDBCodigo.DataSource                 :=dmPrincipal.dsDadosArtigo;
    rlDBCodigo.DataField                  :='cp_id';

    rlDBProduto.DataSource                :=dmPrincipal.dsDadosArtigo;
    rlDBProduto.DataField                 :='cp_descricao';

    rlDBGrupo.DataSource                  :=dmPrincipal.dsDadosArtigo;
    rlDBGrupo.DataField                   :='gr_nome';

    rlDBSubgrupo.DataSource               :=dmPrincipal.dsDadosArtigo;
    rlDBSubGrupo.DataField                :='sgr_nome';

    rlDBTipoProduto.DataSource            :=dmPrincipal.dsDadosArtigo;
    rlDBTipoProduto.DataField             :='tp_nome';

    rlDBComposicao.DataSource             :=dmPrincipal.dsDadosArtigo;
    rlDBComposicao.DataField              :='cm_descricao';


    with dmPrincipal.qryEstArtigos do
    begin
        Close;
        SQL.Clear;
        SQL.Add('SELECT');
        SQL.Add('     CAST(');
        SQL.Add('           COALESCE(gc.grc_codexterno, '''') || '' - '' || TRIM(gc.grc_nome) AS VARCHAR(50)');
        SQL.Add('         ) AS grc_nome_pa,');
        SQL.Add('     gt.grt_nome,');
        SQL.Add('     CASE');
        SQL.Add('         WHEN es.es_entbalanco > 0 THEN ''SIM''');
        SQL.Add('         ELSE ''NAO''');
        SQL.Add('     END AS balanco,');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                       ) -');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                       )');
        SQL.Add('               )AS VARCHAR(20)');
        SQL.Add('     ) || '' '' || cp.cp_un AS estoque_fisico,');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                             COALESCE(es.es_entempenho, 0)');
        SQL.Add('                       )');
        SQL.Add('               ) AS VARCHAR(20)');
        SQL.Add('     ) || '' '' || cp.cp_un AS empenhos,');
        //SQL.Add('');
        SQL.Add('     CAST(');
        SQL.Add('               (');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                             COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                       ) -');
        SQL.Add('                       (');
        SQL.Add('                             COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                             COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                             COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                       )');
        SQL.Add('                       -');
        SQL.Add('                       (');
        SQL.Add('                              COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                              COALESCE(es.es_entempenho, 0)');
        SQL.Add('                       )');
        SQL.Add('              ) AS VARCHAR(20)');
        SQL.Add('    ) || '' '' || cp.cp_un AS estoque_disponivel,');
        SQL.Add('    es.es_custoatual,');
        SQL.Add('    SUM(');
        SQL.Add('              (');
        SQL.Add('                       COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                       COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                       COALESCE(es.es_entbalanco, 0)');
        SQL.Add('              ) -');
        SQL.Add('              (');
        SQL.Add('                       COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                       COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                       COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('              )');
        SQL.Add('    ) OVER() AS total_estoque_fisico,');
        SQL.Add('    SUM(');
        SQL.Add('              COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('              COALESCE(es.es_entempenho, 0)');
        SQL.Add('    ) OVER() AS total_empenhos,');
        SQL.Add('    SUM(');
        SQL.Add('             (');
        SQL.Add('                    (');
        SQL.Add('                           COALESCE(es.es_entradaforn, 0) +');
        SQL.Add('                           COALESCE(es.es_enttransf, 0) +');
        SQL.Add('                           COALESCE(es.es_entbalanco, 0)');
        SQL.Add('                    ) -');
        SQL.Add('                    (');
        SQL.Add('                           COALESCE(es.es_saidaforn, 0) +');
        SQL.Add('                           COALESCE(es.es_saidatransf, 0) +');
        SQL.Add('                           COALESCE(es.es_saidabalanco, 0)');
        SQL.Add('                    )');
        SQL.Add('             ) -');
        SQL.Add('             (');
        SQL.Add('                    COALESCE(es.es_saidaempenho, 0) -');
        SQL.Add('                    COALESCE(es.es_entempenho, 0)');
        SQL.Add('             )');
        SQL.Add('     ) OVER() AS total_estoque_disponivel');
        SQL.Add('     FROM estoque AS es');
        SQL.Add('     JOIN grade_cor AS gc ON gc.grc_id = es.es_idgradecor');
        SQL.Add('     JOIN grade_tamanho AS gt ON gt.grt_id = es.es_idgradetam');
        SQL.Add('     JOIN cadastro_produto AS cp ON cp.cp_id = es.es_codproduto');
        SQL.Add('     WHERE es_codproduto = :idArtigo');
        SQL.Add('     ORDER BY grt_nome');

        ParamByName('idArtigo').AsInteger   :=StrToInt(frmFiltroArtigo.edtCodigo.Text);
        Open;
    end;


    dmPrincipal.dsEstArtigos.DataSet     :=dmPrincipal.qryEstArtigos;


    rlRelArtigos.DataSource              :=dmPrincipal.dsEstArtigos;


    rlDBCor.DataSource                   :=dmPrincipal.dsEstArtigos;
    rlDBCor.DataField                    :='grc_nome_pa';

    rlDBTamanho.DataSource               :=dmPrincipal.dsEstArtigos;
    rlDBTamanho.DataField                :='grt_nome';

    rlDBBalanco.DataSource               :=dmPrincipal.dsEstArtigos;
    rlDBBalanco.DataField                :='balanco';

    rlDBEstFisico.DataSource             :=dmPrincipal.dsEstArtigos;
    rlDBEstFisico.DataField              :='estoque_fisico';

    rlDBEmpenho.DataSource               :=dmPrincipal.dsEstArtigos;
    rlDBEmpenho.DataField                :='empenhos';

    rlDBEstDisponivel.DataSource         :=dmPrincipal.dsEstArtigos;
    rlDBEstDisponivel.DataField          :='estoque_disponivel';

    rlDBCusto.DataSource                 :=dmPrincipal.dsEstArtigos;
    rlDBCusto.DataField                  :='es_custoatual';

end;

procedure TfrmRelArtigos.rlTotaisBeforePrint(Sender: TObject;
  var PrintIt: Boolean);

  var
      totalFisico, totalEmpenhos, totalDisponivel : double;

begin
    totalFisico                 :=dmPrincipal.qryEstArtigos.FieldByName('total_estoque_fisico').AsFloat;
    rlDBTotFisico.Caption       :=FormatFloat('0.0000', totalFisico);

    totalEmpenhos               :=dmPrincipal.qryEstArtigos.FieldByName('total_empenhos').AsFloat;
    rlDBTotEmpenhos.Caption     :=FormatFloat('0.0000', totalEmpenhos);

    totalDisponivel             :=dmPrincipal.qryEstArtigos.FieldByName('total_estoque_disponivel').AsFloat;
    rlDBTotDisponivel.Caption   :=FormatFloat('0.0000', totalDisponivel);
end;

end.
