unit uFiltroProdutividade;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.DBCtrls,
  Vcl.ExtCtrls, Data.DB, Vcl.Grids, Vcl.DBGrids, Vcl.Buttons, Vcl.ComCtrls, System.Generics.Collections;

type
  TfrmFiltroProdutividade = class(TForm)
    dbLkFase: TDBLookupComboBox;
    lblFase: TLabel;
    lblUsuarioFase: TLabel;
    dbLkUsuario: TDBLookupComboBox;
    lblColecao: TLabel;
    dbLkColecao: TDBLookupComboBox;
    lblGrupo: TLabel;
    dbLkGrupo: TDBLookupComboBox;
    lblSubGrupo: TLabel;
    lblEstilista: TLabel;
    dbLkEstilista: TDBLookupComboBox;
    lblTipo: TLabel;
    dbLkTipo: TDBLookupComboBox;
    dbLkSubGrupo: TDBLookupComboBox;
    lblMarca: TLabel;
    dbLkMarca: TDBLookupComboBox;
    lblGenero: TLabel;
    cmbGenero: TComboBox;
    lblGrife: TLabel;
    dbLkGrife: TDBLookupComboBox;
    pnlBuscar: TPanel;
    pnlLimpar: TPanel;
    pnlRetirar: TPanel;
    lblTipoTecido: TLabel;
    DBGrid1: TDBGrid;
    btnBuscar: TSpeedButton;
    btnLimpar: TSpeedButton;
    btnRetirar: TSpeedButton;
    chkPrototipo: TCheckBox;
    chkGE: TCheckBox;
    lblPrototipo: TLabel;
    lblGE: TLabel;
    chkFicha: TCheckBox;
    lblFicha: TLabel;
    chkOrdemCorte: TCheckBox;
    lblOrdemCorte: TLabel;
    lblOrdemProducao: TLabel;
    chkOrdemProducao: TCheckBox;
    lblAnalitico: TLabel;
    lblSintetico: TLabel;
    chkSintetico: TCheckBox;
    chkAnalitico: TCheckBox;
    DateTimePicker1: TDateTimePicker;
    DateTimePicker2: TDateTimePicker;
    Label1: TLabel;
    pnlGerar: TPanel;
    btnGerar: TSpeedButton;
    procedure btnBuscarClick(Sender: TObject);
    procedure btnLimparClick(Sender: TObject);
    procedure btnRetirarClick(Sender: TObject);
    procedure btnGerarClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);

  private
    { Private declarations }
    FKeyMap: TDictionary<Word, TSpeedButton>;
  public
    { Public declarations }
  end;

var
  frmFiltroProdutividade: TfrmFiltroProdutividade;

implementation

{$R *.dfm}



procedure TfrmFiltroProdutividade.btnBuscarClick(Sender: TObject);
begin
    ShowMessage('Estou no botao BUSCAR');
end;

procedure TfrmFiltroProdutividade.btnGerarClick(Sender: TObject);
begin
    ShowMessage('Estou no botao GERAR');
end;

procedure TfrmFiltroProdutividade.btnLimparClick(Sender: TObject);
begin
    ShowMessage('Estou no botao LIMPAR');
end;

procedure TfrmFiltroProdutividade.btnRetirarClick(Sender: TObject);
begin
    ShowMessage('Estou no botao RETIRAR');
end;

procedure TfrmFiltroProdutividade.FormCreate(Sender: TObject);
begin
    KeyPreview  :=true;

    FKeyMap := TDictionary<Word, TSpeedButton>.Create;
    FKeyMap.Add(VK_F1, btnGerar);
    FKeyMap.Add(VK_F2, btnBuscar);
    FKeyMap.Add(VK_F3, btnLimpar);
    FKeyMap.Add(VK_F4, btnRetirar);

end;

procedure TfrmFiltroProdutividade.FormKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);

  var
    btn : TSpeedButton;

begin
    if FKeyMap.TryGetValue(Key, btn) then
    begin
      btn.Click;
      Key :=0;
    end;
end;

end.
