procedure TfrmTipoTecido.gridTipoTecidoKeyPress(Sender: TObject;
  var Key: Char);
begin
    if key = #32 then
    begin
        if dmFiltroProdutividade.cdsTipoTecido.FieldByName('checked').Value = false then
        begin
            dmFiltroProdutividade.cdsTipoTecido.Edit;
            dmFiltroProdutividade.cdsTipoTecido.FieldByName('checked').Value :=true;
        end
        else
        begin
            dmFiltroProdutividade.cdsTipoTecido.Edit;
            dmFiltroProdutividade.cdsTipoTecido.FieldByName('checked').Value :=true;
        end;
    end;
end;

