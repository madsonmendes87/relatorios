procedure TfrmRelArtigos.carregarDados;
begin
    {CABEÇALHO RELATÓRIO}

    dmConexao.Conexao.Connected :=true;

    dmPrincipal.dsDadosArtigo.DataSet     :=dmPrincipal.qryDadosArtigo;

