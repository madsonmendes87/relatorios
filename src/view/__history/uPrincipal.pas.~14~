unit uPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.Buttons,
  Vcl.StdCtrls;

type
  TfrmPrincipal = class(TForm)
    pnlRefOrdCorte: TPanel;
    btnRefOrdCorte: TSpeedButton;
    pnlInfoArtigo: TPanel;
    btnInfoArtigo: TSpeedButton;
    pnlTecidoReferencia: TPanel;
    btnTecidoReferencia: TSpeedButton;
    pnlInfoTecidoComp: TPanel;
    btnInfoTecidoComp: TSpeedButton;
    pnlAnaSintArtEmpenho: TPanel;
    btnAnaSintArtEmpenho: TSpeedButton;
    pnlInfArtReferencia: TPanel;
    btnInfArtReferencia: TSpeedButton;
    pnlProdutividade: TPanel;
    btnProdutividade: TSpeedButton;
    pnlEntradaSaida: TPanel;
    btnEntradaSaida: TSpeedButton;
    pnlInfoArtSintetico: TPanel;
    btnInfoArtSintetico: TSpeedButton;
    pnlFooter: TPanel;
    lblVersao: TLabel;
    procedure FormCreate(Sender: TObject);
    procedure btnInfoArtigoClick(Sender: TObject);
  private
    { Private declarations }
    function VersaoPrograma: string;
  public
    { Public declarations }

  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

{$R *.dfm}

uses uFiltroArtigo, uDmPrincipal;

procedure TfrmPrincipal.btnInfoArtigoClick(Sender: TObject);
begin
    frmFiltroArtigo :=TfrmFiltroArtigo.Create(nil);

    try
      frmFiltroArtigo.ShowModal;
    finally
      FreeAndNil(frmFiltroArtigo);
    end;
end;

procedure TfrmPrincipal.FormCreate(Sender: TObject);
begin
    btnRefOrdCorte.Caption          :='Referências por'#13#10'Ordem de Corte';
    btnInfoArtigo.Caption           :='Informações'#13#10'Artigo(Analitico)';
    btnTecidoReferencia.Caption     :='Tecido usado'#13#10'em referência';
    btnInfoTecidoComp.Caption       :='Informações'#13#10'Tecido e'#13#10'Comprado';
    btnAnaSintArtEmpenho.Caption    :='Analitico e'#13#10'Sintetico Artigo |'#13#10'Empenho |';
    btnInfArtReferencia.Caption     :='Inf. Artigo por'#13#10'Referencia'#13#10'(Sintetico)';
    btnProdutividade.Caption        :='Produtividade';
    btnEntradaSaida.Caption         :='Entrada e Saida'#13#10'(sintético)';
    btnInfoArtSintetico.Caption     :='Informações'#13#10'Artigo (Sintético)';

    lblVersao.Caption := 'Versão ' + VersaoPrograma;
end;

function TfrmPrincipal.VersaoPrograma: string;

var
  InfoSize, Wnd: DWORD;
  VerBuf: Pointer;
  VerInfo: PVSFixedFileInfo;
  VerSize: UINT;

begin
    Result := '';

    InfoSize := GetFileVersionInfoSize(PChar(ParamStr(0)), Wnd);

    if InfoSize <> 0 then
    begin
        GetMem(VerBuf, InfoSize);
        try
            if GetFileVersionInfo(PChar(ParamStr(0)), Wnd, InfoSize, VerBuf) then
            begin
                if VerQueryValue(VerBuf, '\', Pointer(VerInfo), VerSize) then
                begin
                  Result := Format('%d.%d.%d.%d',
                    [HiWord(VerInfo.dwFileVersionMS),
                     LoWord(VerInfo.dwFileVersionMS),
                     HiWord(VerInfo.dwFileVersionLS),
                     LoWord(VerInfo.dwFileVersionLS)]);
                end;
            end;
        finally
            FreeMem(VerBuf);
        end;
    end;
end;

end.
